# Copiar a .env.e2e y completar con el ambiente controlado.
# No commitear .env.e2e.

E2E_BASE_URL=http://localhost:4200
E2E_API_URL=http://localhost:4000/api
E2E_DEFAULT_AMBITO=publico

# Usuarios por rol
E2E_USER_PROFESSIONAL=
E2E_PASS_PROFESSIONAL=
# PIN de 4 dígitos si el profesional de mutaciones tiene PIN activo.
E2E_PROFESSIONAL_PIN=
E2E_USER_PHARMACIST=
E2E_PASS_PHARMACIST=
E2E_USER_AUDITOR=
E2E_PASS_AUDITOR=
E2E_USER_ADMIN=
E2E_PASS_ADMIN=

# Usuario con PIN activo (opcional, para el caso PIN)
E2E_USER_PIN=
E2E_PASS_PIN=
E2E_PIN_VALUE=1234
E2E_WRONG_PIN_VALUE=0000
E2E_PIN_REQUIRED=0

# Datos de prueba
E2E_PATIENT_DNI=39128595
E2E_PATIENT_SEX=Masculino
E2E_PATIENT_TEMP_FIRST_NAME=Paciente
E2E_PATIENT_TEMP_LAST_NAME=
E2E_PATIENT_TEMP_SEX=Otro
E2E_PHARMACY_CUIL=27226637724
E2E_CERTIFICATE_TEXT=
# Vacío = usa la clave local de src/environments/api.key.ts (certificate.local).
E2E_CERTIFICATE_SECRET_KEY=
E2E_PRACTICE_NAME=
E2E_PRACTICE_DIAGNOSTIC=Diagnóstico de prueba E2E

# RENAPER: dejar E2E_RENAPER_ENABLED=0 para omitir estos tests.
E2E_RENAPER_ENABLED=0
E2E_RENAPER_POSITIVE_DNI=32056974
E2E_RENAPER_POSITIVE_SEX=Masculino
E2E_RENAPER_NEGATIVE_DNI=32056975
E2E_RENAPER_NEGATIVE_SEX=Masculino
E2E_ORG_PUBLIC_NAME=
E2E_ORG_PRIVATE_NAME=
E2E_MEDICATION_QUERY=ibuprofeno
E2E_MEDICATION_QUERY_ALT=paracetamol
E2E_MEDICATION_QUERY_EMPTY=zzzzsinresultados
E2E_DIAGNOSTIC=Diagnóstico de prueba E2E
E2E_INDICATION=Indicación de prueba E2E

# Poner en 1 solo si el ambiente está preparado para mutar datos.
E2E_SKIP_MUTATIONS=0

# Poner en 1 si Playwright debe levantar `ng serve`.
E2E_START_APP=0

# 1 = el preflight falla si faltan roles/servicios base.
E2E_STRICT_ENV=0
# 1 = ejecuta el smoke de fixtures descartables (crea y elimina un usuario).
E2E_SMOKE=0
